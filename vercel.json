{
  "version": 2,
  "installCommand": "rm -rf node_modules && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
