{
  "version": 2,
  "installCommand": "rm -rf node_modules && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}